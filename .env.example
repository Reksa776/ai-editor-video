# ---------------------------------------------------------------------------
# AI Video Editor - environment example (SAFE TO COMMIT)
#
# Copy to `.env.local` (Next.js) and fill in real values locally.
# Never commit `.env`, `.env.local`, or any real credential.
#
# Locations:
#   ./env.example                  <- this file (template, committed)
#   ./.env.local                   <- your real values (gitignored)
#   ./media-service/.env           <- Python service values (gitignored)
#   ./media-service/env.example    <- template (committed)
# ---------------------------------------------------------------------------

# --- Prisma CLI only (DDL + migrations). Never loaded by application code. ---
DATABASE_URL="mysql://aivideo_migrator:CHANGE_ME@localhost:3306/aivideo"
SHADOW_DATABASE_URL="mysql://aivideo_migrator:CHANGE_ME@localhost:3306/aivideo_shadow"

# --- Next.js runtime (DML only: SELECT all, write projects + assets) ---
WEB_DATABASE_URL="mysql://aivideo_web:CHANGE_ME@localhost:3306/aivideo"

# --- Application ---
NODE_ENV="development"
MEDIA_SERVICE_URL="http://127.0.0.1:8000"

# --- Storage (absolute or project-relative; must live on /home, never /tmp) ---
PROJECT_STORAGE_PATH="./data/projects"

# --- Uploads ---
# Maximum accepted upload size in bytes (2 GiB).
MAX_UPLOAD_BYTES="2147483648"
