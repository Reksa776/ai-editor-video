# ---------------------------------------------------------------------------
# Media service (FastAPI) - environment example (SAFE TO COMMIT)
#
# Copy to `media-service/.env` and fill in real values locally.
# Driver: mysql+pymysql (SQLAlchemy 2.x + PyMySQL)
# Credentials: aivideo_media (DML on media-owned tables only, no DDL).
# ---------------------------------------------------------------------------

MEDIA_DATABASE_URL="mysql+pymysql://aivideo_media:CHANGE_ME@localhost:3306/aivideo"

PROJECT_STORAGE_PATH="../data/projects"

WORKER_CONCURRENCY=1

APP_ENV="development"

# Bind address for uvicorn (loopback only in development).
MEDIA_HOST="127.0.0.1"
MEDIA_PORT="8000"
